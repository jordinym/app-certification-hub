# DEVELOPMENT TEMPLATE: Codex must verify compatible Node version during Sprint 0.
# Do not treat this as a runnable application until package.json and scripts exist.
FROM node:22-bookworm-slim
WORKDIR /workspace
ENV NODE_ENV=development
ENV HOSTNAME=0.0.0.0
# Dependencies are installed after package-lock.json is generated by S0.
# npm ci is intentionally not invoked in this design-only package.
EXPOSE 3000
CMD ["sh", "-c", "if [ ! -f package.json ]; then echo 'Sprint 0 must scaffold package.json first'; exit 1; fi; npm run dev:cloudflare"]
