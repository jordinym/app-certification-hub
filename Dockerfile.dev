FROM node:22.23.5-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee AS development
RUN npm install --global npm@11.19.1
WORKDIR /workspace
ENV NEXT_TELEMETRY_DISABLED=1 WRANGLER_SEND_METRICS=false
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
EXPOSE 3000
ENTRYPOINT ["sh", "scripts/container-entrypoint.sh"]
CMD ["sh", "scripts/start-local.sh"]

FROM development AS test
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright
RUN npx --no-install playwright install --with-deps chromium
