{
  "name": "app-certification-hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.23.5"
  },
  "scripts": {
    "build": "next build --webpack",
    "build:worker": "opennextjs-cloudflare build",
    "dev:cloudflare": "npm run build:worker && opennextjs-cloudflare preview --ip 0.0.0.0 --port 3000",
    "dev:next": "next dev --hostname 0.0.0.0 --port 3000",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node scripts/db.mjs migrate local",
    "db:seed:local": "node scripts/db.mjs seed local",
    "db:backup:local": "node scripts/db.mjs backup local",
    "db:restore:local": "node scripts/db.mjs restore local",
    "db:migrate:remote": "node scripts/remote-disabled.mjs",
    "db:seed:remote": "node scripts/remote-disabled.mjs",
    "db:backup:remote": "node scripts/remote-disabled.mjs",
    "deploy:remote": "node scripts/remote-disabled.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:integration": "node scripts/test-integration.mjs",
    "test:e2e": "playwright test",
    "test:persistence": "node scripts/persistence.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.17",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.162.0"
  },
  "packageManager": "npm@11.19.1"
}
